{
    "semi": false,
    "singleQuote": false,
    "tabWidth": 4,
    "printWidth": 120,
    "trailingComma": "none",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": ["*.yml", "*.yaml", "*.json", "*.html", "*.md"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
